<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="sale_order_view_tree" model="ir.ui.view">
    <field name="name">sale.order.view.tree.inherit.admin_fee</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.sale_order_tree"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='amount_total']" position="after">
        <field name="admin_fee" string="Relationship Benefit" modifiers="{'sum': 'Total Relationship Benefit'}"/>
      </xpath>
    </field>
  </record>

  <record id="sale_order_view_form" model="ir.ui.view">
    <field name="name">sale.order.view.form.inherit.admin_fee</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='payment_term_id']" position="after">
        <field name="admin_fee_percentage"/>
      </xpath>

      <xpath expr="//field[@name='tax_totals_json']" position="after">
        <field name="amount_with_admin_fee" modifiers="{'invisible': [('admin_fee', '=', 0)]}"/>
        <field name="admin_fee" string="Relationship Benefit"
          modifiers="{'invisible': [('admin_fee', '=', 0)]}"/>
      </xpath>
    </field>
  </record>
</odoo>
